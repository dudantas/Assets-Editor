<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <EditorGeneratedPath>$(MSBuildThisFileDirectory)../../Assets Editor/obj/Debug/net10.0-windows7.0/Appearances.cs</EditorGeneratedPath>
    <EditorProtobufPath>$(MSBuildThisFileDirectory)../../Assets Editor/bin/Debug/net10.0-windows7.0/Google.Protobuf.dll</EditorProtobufPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets Editor/AppearanceSpriteLayout.cs" Link="AppearanceSpriteLayout.cs" />
    <Compile Include="../../Assets Editor/OutfitMaskValidator.cs" Link="OutfitMaskValidator.cs" />
    <Compile Include="$(EditorGeneratedPath)" Link="Appearances.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="SpriteLayerLayoutTests.cs" />
    <Compile Include="OutfitMaskValidatorTests.cs" />
    <Compile Include="UiCompilationCheck.cs" />
    <Compile Include="BoundaryGuardTests.cs" />
    <Reference Include="Google.Protobuf" HintPath="$(EditorProtobufPath)" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
